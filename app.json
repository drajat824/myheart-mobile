{
  "expo": {
    "name": "Digital Health",
    "slug": "Digital Health",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "digitalhealth",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.darojat.digitalhealth",
      "permissions": ["FOREGROUND_SERVICE", "FOREGROUND_SERVICE_CONNECTED_DEVICE", "WAKE_LOCK"]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "Allow Digital Health to connect to bluetooth devices"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          },
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-async-storage/expo-with-async-storage"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b7037c7b-b945-4893-9d96-b47b755a306d"
      }
    },
    "ios": {
      "bundleIdentifier": "com.darojat.digitalhealth"
    }
  }
}
